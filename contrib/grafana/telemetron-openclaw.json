{
  "schemaVersion": 38,
  "style": null,
  "tags": [
    "loki",
    "pack",
    "telemetry",
    "mvp"
  ],
  "timezone": "utc",
  "title": "Loki Pack Telemetry \u2014 Live",
  "uid": "loki-pack-live",
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Agent turns (total, all-time)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "sum(pack_agent_turn_total)",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Tool calls (total, all-time)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "sum(pack_tool_call_total)",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Active deployments",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "count(count by (deployment_id) (pack_emitter_heartbeat_total))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Active packs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "count(count by (pack_name) (pack_emitter_heartbeat_total))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Agent turns / min (by pack, outcome)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "sum by (pack_name, outcome) (rate(pack_agent_turn_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{pack_name}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Tool calls / min (by tool_class)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "sum by (tool_class) (rate(pack_tool_call_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{tool_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Seconds since last heartbeat",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "(time() - timestamp(pack_emitter_heartbeat_total))",
          "refId": "A",
          "legendFormat": "{{deployment_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 8,
      "title": "Heartbeat rate / min (by deployment)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "sum by (deployment_id) (rate(pack_emitter_heartbeat_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{deployment_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Turn outcomes (pie)",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "sum by (outcome) (pack_agent_turn_total)",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Tool class mix (pie)",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "sum by (tool_class) (pack_tool_call_total)",
          "refId": "A",
          "legendFormat": "{{tool_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Live deployments",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "group by (pack_name, deployment_id, deployment_tier, model_family) (pack_agent_turn_total)",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Session starts \u2014 total (all-time, if any)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "sum(pack_session_start_total) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Session starts / min (if any)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_DS_UID"
      },
      "gridPos": {
        "x": 8,
        "y": 31,
        "w": 16,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS_UID"
          },
          "expr": "sum by (pack_name) (rate(pack_session_start_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{pack_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
